# Local dev database (matches docker-compose.yml postgres service at repo root)
# Cổng host 5433 (không phải 5432 mặc định) để tránh xung đột nếu máy đã có Postgres native cài sẵn
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecommerce_dev?schema=public"
PORT=4000
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=n
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
RESEND_API_KEY=
MAIL_FROM=
FRONTEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
PAYMENT_MOCK_ENABLED=
PAYMENT_MOCK_SECRET=
API_PUBLIC_URL=
