# Local dev database (matches docker-compose.yml postgres service at repo root)
# Cổng host 5433 (không phải 5432 mặc định) để tránh xung đột nếu máy đã có Postgres native cài sẵn
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecommerce_dev?schema=public"
PORT=4000
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
RESEND_API_KEY=
MAIL_FROM=
FRONTEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
PAYMENT_MOCK_ENABLED=
PAYMENT_MOCK_SECRET=
API_PUBLIC_URL=

# Tuỳ chọn — bỏ trống thì dùng giá trị mặc định trong code
# CORS: các origin FE được gọi kèm cookie, cách nhau bởi dấu phẩy (mặc định http://localhost:3000,http://localhost:3001)
CORS_ORIGIN=
# Đăng nhập Google: URL callback (mặc định http://localhost:4000/api/v1/auth/google/callback)
GOOGLE_CALLBACK_URL=
# VNPay: khoảng số tiền (VND) cho phép thanh toán qua cổng (mặc định tối thiểu 1.000, tối đa là trần cứng 9.999.999.999)
VNPAY_MIN_AMOUNT=
VNPAY_MAX_AMOUNT=

# Phí vận chuyển giả lập — tỉnh/thành gốc mặc định khi chưa có địa chỉ lấy hàng thật của shop
SHIPPING_DEFAULT_ORIGIN_PROVINCE=

# Checkout — số nhóm thanh toán đang chờ tối đa/user, và vòng đời giữ chỗ thanh toán
MAX_PENDING_CHECKOUTS=
PAYMENT_TTL_MINUTES=
PAYMENT_RECLAIM_GRACE_MINUTES=
PAYMENT_MAX_HOLD_MINUTES=
COD_MAX_AMOUNT=
ORDER_AUTO_COMPLETE_DAYS=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

REFUND_GATEWAY_TIMEOUT_MS=
REFUND_SELLER_RESPONSE_HOURS=
REFUND_ESCALATE_DAYS=
REFUND_MAX_ATTEMPTS=

REVIEW_WINDOW_DAYS=

VNPAY_REFUND_URL=
