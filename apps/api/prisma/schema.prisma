// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Xuất schema sang DBML để import vào dbdiagram.io lấy ảnh ERD auto-layout.
// Chạy lại `npx prisma generate` sau mỗi lần đổi schema để cập nhật file.
generator dbml {
  provider = "prisma-dbml-generator"
  output   = "../generated/dbml"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// Enums
// =========================================================

enum Role {
  USER
  ADMIN
}

// Session-level: tài khoản có được phép dùng hệ thống hay không (khác
// emailVerifiedAt — feature-level, xem User.emailVerifiedAt). Chi tiết thiết
// kế: .claude/docs/auth-shop-status-architecture.md.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

// Seller-level (tầng thứ 3, khác User.accountStatus/emailVerifiedAt): shop có
// được phép đăng bán hay không. Đủ dùng cho "xác minh cơ bản" — không tạo
// bảng SellerVerification/KYC riêng trừ khi phát sinh yêu cầu thật (giấy phép
// kinh doanh, ngân hàng nhận tiền...). Chi tiết:
// .claude/docs/auth-shop-status-architecture.md.
enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Ai thực hiện 1 lần chuyển trạng thái shop (ShopStatusHistory.actorType). OWNER = chủ shop (nộp lại
// hồ sơ bị từ chối); SYSTEM = backfill/hệ thống, không có actorId. Không dùng lại OrderActorType (của
// module khác).
enum ShopActorType {
  OWNER
  ADMIN
  SYSTEM
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  PACKED
  SHIPPING
  COMPLETED
  CANCELLED
  REFUNDED
}

// Ai thực hiện 1 lần chuyển trạng thái đơn (OrderStatusHistory.actorType). SYSTEM = job/cổng thanh
// toán (hết hạn thanh toán, tự hoàn tất đơn, callback VNPay...), không có actorId.
enum OrderActorType {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

enum PaymentMethod {
  VNPAY
  MOMO
  // Thanh toán khi nhận hàng (Week8.md 1.6) — không có cổng; Payment COD ở PENDING tới khi đơn
  // COMPLETED mới chuyển SUCCESS, và không bao giờ hết hạn (expiresAt = null).
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  // Hoàn ĐỦ amount (Payment.refundedAmount = amount). Hoàn một phần (nhóm nhiều đơn, hủy 1 đơn) vẫn SUCCESS.
  REFUNDED
  // "Không thu" (Week9.md 1.2): nhóm COD mà mọi đơn đều CANCELLED — tiền chưa từng được thu. Khác FAILED
  // (lỗi cổng thanh toán, mở đường thanh toán lại) và khác PENDING (còn đang chờ thu).
  CANCELLED
}

enum VoucherType {
  PERCENT
  FIXED
}

enum OAuthProvider {
  GOOGLE
}

// =========================================================
// User & Auth
// =========================================================

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  // Nullable — user tạo qua OAuth (xem OAuthAccount) không có mật khẩu.
  // AuthService.login() báo lỗi rõ ràng nếu user chỉ có OAuth mà cố login
  // bằng password.
  passwordHash     String?       @map("password_hash")
  name             String
  role             Role          @default(USER)
  accountStatus    AccountStatus @default(ACTIVE) @map("account_status")
  refreshTokenHash String?       @map("refresh_token_hash")

  // Email verification (Tuần 2, Bước 2.10) — token dùng 1 lần, hash bằng SHA-256
  // giống refreshTokenHash (không dùng bcrypt, lý do xem AuthService.hashToken).
  // emailVerificationTokenHash null nghĩa là không có token verify nào đang chờ
  // xử lý (đã verify xong hoặc chưa từng gửi) — không suy ra được đã verify hay
  // chưa từ riêng field này, phải check emailVerifiedAt.
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationTokenHash String?   @unique @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  emailVerificationSentAt    DateTime? @map("email_verification_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shops          Shop[]
  addresses      Address[]
  cart           Cart?
  orders         Order[]
  checkoutGroups CheckoutGroup[]
  voucherUsages  VoucherUsage[]
  reviews        Review[]
  refundRequests RefundRequest[]
  wishlists      Wishlist[]
  conversations  Conversation[]  @relation("BuyerConversations")
  messages       Message[]
  oauthAccounts  OAuthAccount[]

  @@map("users")
}

// 1 User có thể liên kết nhiều provider OAuth (Google, sau này Facebook...)
// — tách bảng riêng thay vì thêm field googleId/facebookId thẳng vào User để
// không phải đổi schema mỗi lần thêm provider mới, và cho phép 1 user link
// nhiều provider cùng lúc (đăng ký bằng password, sau đó "liên kết Google").
model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Sổ địa chỉ dùng chung: đúng 1 trong 2 FK (userId/shopId) có giá trị (CHECK
// viết tay trong migration add_checkout_order_payment_schema), và mỗi user tối
// đa 1 địa chỉ mặc định (unique index từng phần, cũng viết tay — Prisma không
// khai được cả hai). ward = "Xã/Phường/Đặc khu"; không có cấp quận/huyện.
model Address {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  shopId        String?  @map("shop_id")
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  ward          String
  province      String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopId])
  @@map("addresses")
}

// =========================================================
// Shop
// =========================================================

// Business rule Tuần 3 Bước 1.6: 1 user tối đa 1 shop cho MVP hiện tại,
// nhưng KHÔNG khoá bằng @unique — TikTok Shop thật có tính năng "Multi-Store"
// cho 1 số seller (cross-border/agency), tức schema thật của họ vẫn cho 1
// User sở hữu nhiều Shop. Giữ quan hệ "User 1-n Shop" thuần, giới hạn "tối
// đa 1" chỉ là business rule enforce ở ShopService (check trước khi create,
// 409 nếu đã có) — xem shop-ownership-mvp-note.md. Đánh đổi: chấp nhận 1
// khe hở race hiếm gặp (2 request POST /shops gần như đồng thời) để không
// giả định cứng "sẽ không bao giờ cần multi-shop".
model Shop {
  id              String     @id @default(uuid())
  ownerId         String     @map("owner_id")
  name            String
  slug            String     @unique
  logoUrl         String?    @map("logo_url")
  bannerUrl       String?    @map("banner_url")
  description     String?
  status          ShopStatus @default(PENDING)
  // Lý do của trạng thái HIỆN TẠI do Admin nhập (từ chối hoặc khoá); null khi PENDING/APPROVED. Là
  // bản sao có chủ đích để banner seller và danh sách Admin không phải đọc ShopStatusHistory mỗi lần
  // render — nguồn audit đầy đủ là ShopStatusHistory (ghi cùng transaction ở ShopStatusService).
  statusReason    String?    @map("status_reason")
  // Mốc đổi trạng thái gần nhất (hàng chờ duyệt xếp theo cột này, shop nộp lại xếp theo lúc nộp lại).
  // KHÔNG dùng updatedAt: updatedAt đổi cả khi chủ shop sửa thông tin. Denormalization có chủ đích
  // (= ShopStatusHistory.createdAt mới nhất) để khỏi MAX() mỗi lần truy vấn; chỉ ShopStatusService
  // được ghi cột này.
  statusChangedAt DateTime   @default(now()) @map("status_changed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  addresses      Address[]
  products       Product[]
  variants       ProductVariant[]
  orders         Order[]
  vouchers       Voucher[]
  conversations  Conversation[]
  statusHistory  ShopStatusHistory[]
  refundRequests RefundRequest[]

  @@index([ownerId])
  // Hàng chờ duyệt: WHERE status = 'PENDING' ORDER BY status_changed_at (Week8.md 3C).
  @@index([status, statusChangedAt])
  @@map("shops")
}

// Lịch sử đổi trạng thái shop (cùng mẫu OrderStatusHistory): audit + nguồn suy ra "lý do từ chối lần
// trước" và "số lần nộp lại" ở danh sách Admin. fromStatus null = mốc tạo shop. Không có cột `action`
// — suy ra từ cặp (from -> to). `note` là LÝ DO DO NGƯỜI NHẬP, hiển thị được cho seller; không bao giờ
// ghi chuỗi hệ thống vào đây (dòng backfill phân biệt bằng actorType = SYSTEM, không bằng note).
model ShopStatusHistory {
  id         String        @id @default(uuid())
  shopId     String        @map("shop_id")
  fromStatus ShopStatus?   @map("from_status")
  toStatus   ShopStatus    @map("to_status")
  actorType  ShopActorType @map("actor_type")
  actorId    String?       @map("actor_id")
  note       String?
  createdAt  DateTime      @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@map("shop_status_histories")
}

// =========================================================
// Catalog
// =========================================================

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String? @map("parent_id")

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String        @map("shop_id")
  categoryId  String        @map("category_id")
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  // Denormalized từ variants.price (chỉ tính isActive=true) — Prisma không
  // cho orderBy/filter theo _min/_max của quan hệ 1-nhiều (ProductVariant),
  // nên cần cache sẵn ở Product để listPublicProducts (Tuần 4 Bước 2.10)
  // sort/filter theo giá được native qua Prisma, không cần raw SQL. Service
  // (ProductService.createProduct/updateProduct) chịu trách nhiệm tự tính
  // lại mỗi khi tập variant active thay đổi — không có DB trigger nào giữ
  // đồng bộ hộ.
  minPrice    Decimal       @map("min_price") @db.Decimal(12, 2)
  maxPrice    Decimal       @map("max_price") @db.Decimal(12, 2)
  // Denormalized từ reviews (Week9.md 1.8) — cùng lý do với minPrice/maxPrice: Prisma không orderBy được
  // theo aggregate của quan hệ 1-nhiều, mà danh sách public cần sort theo rating và card cần hiện sao.
  // Không phải tiền nên Float đủ (làm tròn 2 chữ số khi ghi). Chỉ ProductRatingService.recompute được ghi
  // 2 cột này (tính lại từ COUNT/AVG dưới khoá dòng product nên tự chữa lành nếu có lệch); CHECK DB:
  // 0 <= avg_rating <= 5, review_count >= 0.
  avgRating   Float         @default(0) @map("avg_rating")
  reviewCount Int           @default(0) @map("review_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Week5.md Bước 1.6/2.4b — search full-text. Prisma không có type gốc cho
  // `tsvector`, khai qua `Unsupported` (field này bị loại khỏi Prisma Client
  // tự sinh, chỉ query được qua `$queryRaw` — đúng ProductService.listPublicProducts
  // ở Bước 2.5). Không tự set giá trị ở service — 1 trigger Postgres (thêm
  // bằng raw SQL trong migration, Prisma không có khái niệm trigger) tự cập
  // nhật cột này mỗi khi `name`/`description` đổi.
  searchVector Unsupported("tsvector")? @map("search_vector")

  shop       Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   Category           @relation(fields: [categoryId], references: [id])
  attributes ProductAttribute[]
  variants   ProductVariant[]
  reviews    Review[]
  wishlists  Wishlist[]

  // Composite (không phải index đơn) vì query public list luôn filter kèm
  // status = PUBLISHED cùng lúc với shopId/categoryId (rules/backend.md mục
  // 4) — index đơn trên shopId/categoryId đủ cho Tuần 1-3 nhưng không khớp
  // pattern query thật của Tuần 4. Cột đứng trước (shopId/categoryId) vẫn
  // phục vụ được query chỉ filter theo 1 cột đó (vd getMyProducts theo
  // shopId, mọi status) nên không cần giữ thêm index đơn song song.
  @@index([shopId, status])
  @@index([categoryId, status])
  // Sort theo rating ở danh sách public (luôn kèm status = PUBLISHED) — Week9.md 1.8.
  @@index([status, avgRating])
  @@index([searchVector], type: Gin)
  @@map("products")
}

// Mỗi Product tự khai báo nhóm thuộc tính riêng (vd "Màu sắc", "Dung lượng")
// — không cố định cứng theo 1 ngành hàng.
model ProductAttribute {
  id        String @id @default(uuid())
  productId String @map("product_id")
  name      String
  position  Int    @default(0)

  product Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductAttributeValue[]

  @@index([productId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String @id @default(uuid())
  attributeId String @map("attribute_id")
  value       String

  attribute     ProductAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@index([attributeId])
  @@map("product_attribute_values")
}

// sku chỉ unique trong phạm vi 1 shop (@@unique([shopId, sku])), không phải
// toàn sàn — đúng thực tế multi-vendor (Shopee/Lazada/Amazon Marketplace đều
// để "Seller SKU" do từng seller tự quản lý, không unique giữa các seller).
// shopId ở đây là denormalized ownership reference (không thay thế productId
// — quan hệ nghiệp vụ chính vẫn là product), bắt buộc gán bằng chính
// product.shopId đã load trong transaction khi tạo/sửa Product — không nhận
// field này từ payload FE.
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  shopId        String   @map("shop_id")
  sku           String
  price         Decimal  @db.Decimal(12, 2)
  // stock = kho vật lý; reservedStock = số đang giữ chỗ cho đơn chưa thanh toán.
  // available = stock - reservedStock. Bất biến 0 <= reservedStock <= stock được
  // bảo vệ bằng CHECK ở DB (viết tay trong migration, Prisma không khai được).
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock")
  isActive      Boolean  @default(true) @map("is_active")
  weightGram    Int?     @map("weight_gram")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop            Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([shopId, sku])
  @@index([productId])
  @@index([shopId])
  @@map("product_variants")
}

// Week5.md Bước 1.3/2.12 — nhiều ảnh/variant (đổi màu → đổi cả bộ ảnh), thay
// cho field đơn ProductVariant.imageUrl cũ. Gắn ở cấp VARIANT, không phải
// Product (mỗi combo màu/size có bộ ảnh riêng, đúng pattern Shopee/Lazada).
model ProductImage {
  id        String   @id @default(uuid())
  variantId String   @map("variant_id")
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("product_images")
}

// Bảng nối: xác định 1 variant là tổ hợp của những giá trị thuộc tính nào
// (vd variant = {Màu: Đỏ} x {Dung lượng: 128GB})
model VariantAttributeValue {
  id               String @id @default(uuid())
  variantId        String @map("variant_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

// =========================================================
// Cart & Checkout
// =========================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid())
  cartId           String   @map("cart_id")
  productVariantId String   @map("product_variant_id")
  quantity         Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
  @@map("cart_items")
}

// =========================================================
// Order & Payment
// =========================================================

// Đại diện cho 1 lần checkout — khi giỏ hàng có nhiều shop, tách thành
// nhiều Order (mỗi Order 1 shop) nhưng share chung 1 CheckoutGroup để
// gộp thanh toán 1 lần (VNPay/Momo) cho toàn bộ đơn.
model CheckoutGroup {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  // Header Idempotency-Key của POST /checkout: gọi lại cùng key trả đúng nhóm
  // đã tạo thay vì đặt trùng. Postgres coi nhiều NULL là khác nhau nên không
  // xung đột khi client không gửi key.
  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id])
  orders        Order[]
  payments      Payment[]
  voucherUsages VoucherUsage[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("checkout_groups")
}

// Order luôn gắn với đúng 1 Shop (multi-vendor: giỏ hàng nhiều shop
// tách thành nhiều Order khi checkout, gộp thanh toán qua checkoutGroupId).
model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  shopId          String      @map("shop_id")
  checkoutGroupId String      @map("checkout_group_id")
  // Mặc định là trạng thái an toàn (chưa thanh toán); PENDING = đã thanh toán,
  // chờ shop xác nhận. Đơn COD tương lai sẽ khai PENDING tường minh.
  status          OrderStatus @default(AWAITING_PAYMENT)
  // totalAmount = tổng OrderItem - discountAmount + shippingFee (số buyer trả cho đơn này)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  voucherId       String?     @map("voucher_id")

  // Snapshot địa chỉ giao hàng tại thời điểm đặt (không FK sống tới Address)
  recipientName       String @map("recipient_name")
  recipientPhone      String @map("recipient_phone")
  shippingAddressLine String @map("shipping_address_line")
  shippingWard        String @map("shipping_ward")
  shippingProvince    String @map("shipping_province")

  // Thông tin vận chuyển Seller nhập tay lúc chuyển PACKED -> SHIPPING (Week8.md 1.10) — text tự do,
  // không bắt buộc, không tích hợp hãng vận chuyển thật.
  carrier      String?
  trackingCode String? @map("tracking_code")

  // Lời nhắn của người mua cho ĐÚNG shop của đơn này (Week8.md 3B) — mỗi đơn một lời nhắn riêng nên
  // shop A không thấy lời nhắn gửi shop B. Văn bản thuần, đã trim, tối đa 500 ký tự
  // (ORDER_NOTE_MAX_LENGTH), không bao giờ là chuỗi rỗng (rỗng ⇒ NULL), đặt xong không sửa.
  // Khác OrderStatusHistory.note (lý do đổi trạng thái do shop/hệ thống ghi).
  buyerNote String? @map("buyer_note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id])
  shop           Shop                 @relation(fields: [shopId], references: [id])
  voucher        Voucher?             @relation(fields: [voucherId], references: [id])
  checkoutGroup  CheckoutGroup        @relation(fields: [checkoutGroupId], references: [id])
  items          OrderItem[]
  reviews        Review[]
  statusHistory  OrderStatusHistory[]
  refundRequests RefundRequest[]
  paymentRefund  PaymentRefund?

  // Khớp đúng query Tuần 8 (Week8.md 1.11): danh sách đơn của buyer (userId, mới nhất trước) và của
  // seller (shopId + lọc status, mới nhất trước). Cột đứng đầu đã tự phục vụ mọi query theo
  // userId/shopId trước đây nên thay thế hẳn index đơn cũ (rules/backend.md mục 4).
  @@index([userId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([checkoutGroupId])
  @@index([voucherId])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String  @map("order_id")
  productVariantId String  @map("product_variant_id")
  quantity         Int
  priceAtPurchase  Decimal @map("price_at_purchase") @db.Decimal(12, 2)

  // Snapshot định danh dòng hàng lúc mua — Seller đổi tên/thuộc tính/ẩn variant
  // sau đó không làm đổi lịch sử đơn. productVariantId vẫn giữ để nối review/hoàn tiền.
  productName  String  @map("product_name")
  variantLabel String? @map("variant_label")
  sku          String
  imageUrl     String? @map("image_url")

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

// Timeline trạng thái đơn (Week8.md 1.3/1.4) — NGUỒN SỰ THẬT duy nhất cho "đơn đổi trạng thái lúc
// nào, ai đổi, vì sao" (thời điểm giao/hoàn tất/hủy, lý do hủy ở `note`), không có cột riêng trên
// Order. Mọi lần đổi Order.status đi qua OrderStatusService và ghi 1 dòng ở đây trong cùng
// transaction. fromStatus = null là mốc tạo đơn.
model OrderStatusHistory {
  id         String         @id @default(uuid())
  orderId    String         @map("order_id")
  fromStatus OrderStatus?   @map("from_status")
  toStatus   OrderStatus    @map("to_status")
  actorType  OrderActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

// Loại yêu cầu của người mua (Week9.md 1.3): CANCEL = xin hủy khi shop đã xác nhận/đóng gói (CONFIRMED,
// PACKED); RETURN = xin trả hàng/hoàn tiền sau khi đã nhận (COMPLETED, trong cửa sổ hoàn trả).
enum RefundRequestKind {
  CANCEL
  RETURN
}

// Vòng đời yêu cầu (Week9.md 1.4). Bảng chuyển hợp lệ + actor là hằng số REFUND_REQUEST_TRANSITIONS ở
// packages/types; điểm ghi duy nhất là RefundRequestService.transition (kèm RefundRequestHistory).
enum RefundRequestStatus {
  PENDING_SELLER
  APPROVED
  REJECTED_BY_SELLER
  ESCALATED
  REJECTED
  WITHDRAWN
}

// Trạng thái của MỘT lần hoàn tiền ra khỏi hệ thống (sổ cái tiền, tách khỏi quy trình xin/duyệt).
enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// 1 Payment (1 giao dịch VNPay/Momo) có thể trả cho nhiều Order (nhiều shop)
// cùng lúc, gộp nhóm qua checkoutGroupId — không FK trực tiếp tới Order.
model Payment {
  id              String        @id @default(uuid())
  checkoutGroupId String        @map("checkout_group_id")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  // Payment là 1 LẦN THỬ thanh toán: 1 nhóm có thể có nhiều Payment.
  // txnRef = mã tham chiếu gửi cổng (duy nhất mỗi lần thử); transactionId = mã
  // do cổng trả về (nullable) — không dùng lẫn.
  txnRef          String        @unique @map("txn_ref")
  transactionId   String?       @map("transaction_id")
  amount          Decimal       @db.Decimal(12, 2)
  payUrl          String?       @map("pay_url")
  paidAt          DateTime?     @map("paid_at")
  // null = không hết hạn (chỉ COD, Week8.md 1.6). PaymentExpiryJob lọc `expiresAt < now` nên tự bỏ
  // qua NULL (so sánh với NULL không bao giờ đúng).
  expiresAt       DateTime?     @map("expires_at")
  // Tổng các PaymentRefund đã SUCCEEDED của Payment này (Week9.md 1.2). Denormalization có chủ đích để
  // kiểm "không hoàn quá số đã thu" bằng 1 câu UPDATE có điều kiện + CHECK DB (0 <= refunded_amount <=
  // amount, SQL tay trong migration) thay vì cộng lại sổ cái mỗi lần; chỉ RefundService ghi cột này.
  // status REFUNDED chỉ khi refundedAmount = amount.
  refundedAmount  Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  checkoutGroup CheckoutGroup   @relation(fields: [checkoutGroupId], references: [id])
  refunds       PaymentRefund[]

  @@index([checkoutGroupId])
  @@index([status, expiresAt])
  @@map("payments")
}

// Yêu cầu hủy/trả hàng của người mua (Week9.md 1.4) — QUY TRÌNH xin/duyệt. Hủy ngay khi shop chưa xác
// nhận và hoàn tiền do Admin chủ động KHÔNG có dòng ở đây (chỉ có PaymentRefund). Mỗi đơn tối đa 1 yêu
// cầu mỗi loại trừ yêu cầu đã rút: index duy nhất từng phần (order_id, kind) WHERE status <> 'WITHDRAWN'
// viết tay trong migration vì Prisma không biểu diễn được. shopId nhân bản bất biến từ đơn (đơn không bao
// giờ đổi shop) để có hàng chờ seller theo index [shopId, status, createdAt] mà không join. reasonNote do
// NGƯỜI MUA nhập; lý do của người ra quyết định nằm ở RefundRequestHistory.note.
model RefundRequest {
  id              String              @id @default(uuid())
  orderId         String              @map("order_id")
  shopId          String              @map("shop_id")
  userId          String              @map("user_id")
  kind            RefundRequestKind
  status          RefundRequestStatus @default(PENDING_SELLER)
  // Mã lý do là chuỗi kiểm bằng Zod (REFUND_REASON_CODES ở packages/types), không phải enum DB, để thêm mã
  // không cần migration.
  reasonCode      String              @map("reason_code")
  reasonNote      String?             @map("reason_note") @db.VarChar(500)
  // Hạn seller phản hồi; quá hạn RefundJob tự duyệt (CANCEL) hoặc chuyển Admin (RETURN).
  sellerRespondBy DateTime            @map("seller_respond_by")
  // Mốc đổi trạng thái gần nhất (cùng mẫu Shop.statusChangedAt): tính cửa sổ khiếu nại từ lúc seller từ chối
  // và xếp hàng chờ Admin theo lúc được chuyển lên. Chỉ RefundRequestService.transition được ghi cột này.
  statusChangedAt DateTime            @default(now()) @map("status_changed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  order         Order                  @relation(fields: [orderId], references: [id])
  shop          Shop                   @relation(fields: [shopId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])
  history       RefundRequestHistory[]
  paymentRefund PaymentRefund?

  @@index([orderId])
  @@index([shopId, status, createdAt])
  @@index([userId, createdAt])
  // RefundJob: PENDING_SELLER quá hạn phản hồi.
  @@index([status, sellerRespondBy])
  @@map("refund_requests")
}

// Dòng thời gian của yêu cầu (cùng mẫu OrderStatusHistory/ShopStatusHistory): nguồn sự thật cho timeline
// và cho "ai quyết định". fromStatus null = mốc tạo yêu cầu. `note` là LÝ DO DO NGƯỜI RA QUYẾT ĐỊNH nhập
// (seller từ chối, Admin duyệt/từ chối), người kia đọc được; luôn NULL khi không có lý do — không bao giờ
// ghi chuỗi mặc định. API không trả actorId cho buyer/seller.
model RefundRequestHistory {
  id              String               @id @default(uuid())
  refundRequestId String               @map("refund_request_id")
  fromStatus      RefundRequestStatus? @map("from_status")
  toStatus        RefundRequestStatus  @map("to_status")
  actorType       OrderActorType       @map("actor_type")
  actorId         String?              @map("actor_id")
  note            String?
  createdAt       DateTime             @default(now()) @map("created_at")

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)

  @@index([refundRequestId, createdAt])
  @@map("refund_request_histories")
}

// Sổ cái tiền hoàn (Week9.md 1.4/1.5): mỗi dòng là một khoản tiền ra khỏi hệ thống qua cổng. Tạo cả khi hủy
// ngay/seller hủy/Admin hoàn thanh toán bất thường (không cần RefundRequest). orderId unique ⇒ một đơn chỉ
// được hoàn một lần (thử lại dùng lại CÙNG dòng, tăng attempts); orderId NULL = hoàn thanh toán không gắn
// đơn (PAID_AFTER_EXPIRY, thanh toán trùng) — mỗi Payment chỉ một dòng như vậy (index duy nhất từng phần
// (payment_id) WHERE order_id IS NULL, SQL tay). Đơn COD KHÔNG có dòng ở đây (hoàn tiền mặt ngoài hệ thống).
// Chỉ RefundService ghi bảng này (và cột Payment.refundedAmount).
model PaymentRefund {
  id              String              @id @default(uuid())
  paymentId       String              @map("payment_id")
  orderId         String?             @unique @map("order_id")
  refundRequestId String?             @unique @map("refund_request_id")
  amount          Decimal             @db.Decimal(12, 2)
  status          PaymentRefundStatus @default(PENDING)
  // Mã hoàn do cổng trả về; hoàn thủ công ghi 'MANUAL:<mã tham chiếu>'.
  gatewayRef      String?             @map("gateway_ref")
  failureReason   String?             @map("failure_reason") @db.VarChar(500)
  reason          String?             @db.VarChar(500)
  initiatedByType OrderActorType      @map("initiated_by_type")
  initiatedById   String?             @map("initiated_by_id")
  attempts        Int                 @default(0)
  createdAt       DateTime            @default(now()) @map("created_at")
  completedAt     DateTime?           @map("completed_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  payment       Payment        @relation(fields: [paymentId], references: [id])
  // Restrict TƯỜNG MINH: với quan hệ tuỳ chọn Prisma mặc định SET NULL, mà order_id NULL mang nghĩa "hoàn
  // thanh toán không gắn đơn" — xoá đơn không được âm thầm biến dòng hoàn tiền thành loại đó.
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundRequest RefundRequest? @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  // Màn Admin (FAILED/PENDING quá hạn) và lượt quét hoàn tiền bỏ dở của RefundJob; mỗi lần thử làm mới
  // updatedAt nên các lần thử cách nhau đủ xa.
  @@index([status, updatedAt])
  @@map("payment_refunds")
}

// =========================================================
// Voucher
// =========================================================

model Voucher {
  id                String      @id @default(uuid())
  shopId            String?     @map("shop_id")
  code              String      @unique
  type              VoucherType
  value             Decimal     @db.Decimal(12, 2)
  minOrderAmount    Decimal?    @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?    @map("max_discount_amount") @db.Decimal(12, 2)
  usageLimit        Int?        @map("usage_limit")
  perUserLimit      Int?        @map("per_user_limit")
  usedCount         Int         @default(0) @map("used_count")
  isActive          Boolean     @default(true) @map("is_active")
  expiresAt         DateTime?   @map("expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")

  shop   Shop?          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]
  usages VoucherUsage[]

  @@index([shopId])
  @@map("vouchers")
}

// 1 dòng = 1 lần checkout dùng voucher (voucher toàn sàn tách N Order vẫn chỉ
// tính 1 lượt). Vouchers.usedCount = số dòng chưa nhả (releasedAt IS NULL), kể
// cả lần đang giữ chỗ chờ thanh toán. Nhả lượt bằng releasedAt (xoá mềm), không
// xoá dòng — giữ lịch sử cho đối soát/hoàn tiền.
model VoucherUsage {
  id              String    @id @default(uuid())
  voucherId       String    @map("voucher_id")
  userId          String    @map("user_id")
  checkoutGroupId String    @map("checkout_group_id")
  // Tổng Order.discountAmount của nhóm
  discountAmount  Decimal   @map("discount_amount") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  releasedAt      DateTime? @map("released_at")

  voucher       Voucher       @relation(fields: [voucherId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  checkoutGroup CheckoutGroup @relation(fields: [checkoutGroupId], references: [id])

  @@unique([voucherId, checkoutGroupId])
  @@index([voucherId, userId])
  @@index([checkoutGroupId])
  @@map("voucher_usages")
}

// =========================================================
// Review
// =========================================================

// Đánh giá của người mua cho 1 sản phẩm trong 1 đơn đã COMPLETED (Week9.md 1.8): mỗi (user, sản phẩm,
// đơn) một đánh giá. Rating 1-5 và độ dài comment được CHECK ở DB (SQL tay trong migration). Người mua sửa
// ĐƯỢC MỘT LẦN (editedAt đánh dấu đã sửa) và không tự xoá. Seller trả lời một lần ngay trên dòng này
// (sellerReply/sellerRepliedAt, có thể sửa lại, không xoá). Khi tạo/sửa, Product.avgRating/reviewCount
// được tính lại bởi ProductRatingService (điểm ghi duy nhất).
model Review {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  productId       String    @map("product_id")
  orderId         String    @map("order_id")
  rating          Int
  comment         String?
  editedAt        DateTime? @map("edited_at")
  sellerReply     String?   @map("seller_reply") @db.VarChar(1000)
  sellerRepliedAt DateTime? @map("seller_replied_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, orderId])
  // Danh sách đánh giá của 1 sản phẩm, mới nhất trước; lọc theo số sao là bộ lọc trên tập nhỏ đó.
  @@index([productId, createdAt])
  @@index([orderId])
  @@map("reviews")
}

// =========================================================
// Chat
// =========================================================

model Conversation {
  id        String   @id @default(uuid())
  buyerId   String   @map("buyer_id")
  shopId    String   @map("shop_id")
  createdAt DateTime @default(now()) @map("created_at")

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, shopId])
  @@index([shopId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
