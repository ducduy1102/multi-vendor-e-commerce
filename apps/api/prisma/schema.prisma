// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Xuất schema sang DBML để import vào dbdiagram.io lấy ảnh ERD auto-layout.
// Chạy lại `npx prisma generate` sau mỗi lần đổi schema để cập nhật file.
generator dbml {
  provider = "prisma-dbml-generator"
  output   = "../generated/dbml"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// Enums
// =========================================================

enum Role {
  USER
  ADMIN
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum VoucherType {
  PERCENT
  FIXED
}

// =========================================================
// User & Auth
// =========================================================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  name             String
  role             Role     @default(USER)
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shops         Shop[]
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  conversations Conversation[] @relation("BuyerConversations")
  messages      Message[]

  @@map("users")
}

// Sổ địa chỉ dùng chung: đúng 1 trong 2 FK (userId/shopId) có giá trị,
// enforce ở tầng service (Prisma không hỗ trợ CHECK constraint kiểu này).
model Address {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  shopId        String?  @map("shop_id")
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  ward          String
  district      String
  province      String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopId])
  @@map("addresses")
}

// =========================================================
// Shop
// =========================================================

model Shop {
  id          String     @id @default(uuid())
  ownerId     String     @map("owner_id")
  name        String
  slug        String     @unique
  logoUrl     String?    @map("logo_url")
  bannerUrl   String?    @map("banner_url")
  description String?
  status      ShopStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  addresses     Address[]
  products      Product[]
  orders        Order[]
  vouchers      Voucher[]
  conversations Conversation[]

  @@index([ownerId])
  @@map("shops")
}

// =========================================================
// Catalog
// =========================================================

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String? @map("parent_id")

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String        @map("shop_id")
  categoryId  String        @map("category_id")
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  shop       Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   Category           @relation(fields: [categoryId], references: [id])
  attributes ProductAttribute[]
  variants   ProductVariant[]
  reviews    Review[]
  wishlists  Wishlist[]

  @@index([shopId])
  @@index([categoryId])
  @@map("products")
}

// Mỗi Product tự khai báo nhóm thuộc tính riêng (vd "Màu sắc", "Dung lượng")
// — không cố định cứng theo 1 ngành hàng.
model ProductAttribute {
  id        String @id @default(uuid())
  productId String @map("product_id")
  name      String
  position  Int    @default(0)

  product Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductAttributeValue[]

  @@index([productId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String @id @default(uuid())
  attributeId String @map("attribute_id")
  value       String

  attribute     ProductAttribute         @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@index([attributeId])
  @@map("product_attribute_values")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  sku        String   @unique
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  imageUrl   String?  @map("image_url")
  weightGram Int?     @map("weight_gram")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product         Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// Bảng nối: xác định 1 variant là tổ hợp của những giá trị thuộc tính nào
// (vd variant = {Màu: Đỏ} x {Dung lượng: 128GB})
model VariantAttributeValue {
  id               String @id @default(uuid())
  variantId        String @map("variant_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue  @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

// =========================================================
// Cart & Checkout
// =========================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String @id @default(uuid())
  cartId           String @map("cart_id")
  productVariantId String @map("product_variant_id")
  quantity         Int    @default(1)

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
  @@map("cart_items")
}

// =========================================================
// Order & Payment
// =========================================================

// Đại diện cho 1 lần checkout — khi giỏ hàng có nhiều shop, tách thành
// nhiều Order (mỗi Order 1 shop) nhưng share chung 1 CheckoutGroup để
// gộp thanh toán 1 lần (VNPay/Momo) cho toàn bộ đơn.
model CheckoutGroup {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  orders   Order[]
  payments Payment[]

  @@index([userId])
  @@map("checkout_groups")
}

// Order luôn gắn với đúng 1 Shop (multi-vendor: giỏ hàng nhiều shop
// tách thành nhiều Order khi checkout, gộp thanh toán qua checkoutGroupId).
model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  shopId          String      @map("shop_id")
  checkoutGroupId String      @map("checkout_group_id")
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  voucherId       String?     @map("voucher_id")

  // Snapshot địa chỉ giao hàng tại thời điểm đặt (không FK sống tới Address)
  recipientName       String @map("recipient_name")
  recipientPhone      String @map("recipient_phone")
  shippingAddressLine String @map("shipping_address_line")
  shippingWard        String @map("shipping_ward")
  shippingDistrict    String @map("shipping_district")
  shippingProvince    String @map("shipping_province")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id])
  shop          Shop          @relation(fields: [shopId], references: [id])
  voucher       Voucher?      @relation(fields: [voucherId], references: [id])
  checkoutGroup CheckoutGroup @relation(fields: [checkoutGroupId], references: [id])
  items         OrderItem[]
  reviews       Review[]

  @@index([userId])
  @@index([shopId])
  @@index([checkoutGroupId])
  @@index([voucherId])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String  @map("order_id")
  productVariantId String  @map("product_variant_id")
  quantity         Int
  priceAtPurchase  Decimal @map("price_at_purchase") @db.Decimal(12, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

// 1 Payment (1 giao dịch VNPay/Momo) có thể trả cho nhiều Order (nhiều shop)
// cùng lúc, gộp nhóm qua checkoutGroupId — không FK trực tiếp tới Order.
model Payment {
  id              String        @id @default(uuid())
  checkoutGroupId String        @map("checkout_group_id")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @map("transaction_id")
  amount          Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  checkoutGroup CheckoutGroup @relation(fields: [checkoutGroupId], references: [id])

  @@index([checkoutGroupId])
  @@map("payments")
}

// =========================================================
// Voucher
// =========================================================

model Voucher {
  id                String      @id @default(uuid())
  shopId            String?     @map("shop_id")
  code              String      @unique
  type              VoucherType
  value             Decimal     @db.Decimal(12, 2)
  minOrderAmount    Decimal?    @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?    @map("max_discount_amount") @db.Decimal(12, 2)
  usageLimit        Int?        @map("usage_limit")
  perUserLimit      Int?        @map("per_user_limit")
  usedCount         Int         @default(0) @map("used_count")
  expiresAt         DateTime?   @map("expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")

  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([shopId])
  @@map("vouchers")
}

// =========================================================
// Review
// =========================================================

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  orderId   String   @map("order_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, orderId])
  @@index([productId])
  @@index([orderId])
  @@map("reviews")
}

// =========================================================
// Chat
// =========================================================

model Conversation {
  id        String   @id @default(uuid())
  buyerId   String   @map("buyer_id")
  shopId    String   @map("shop_id")
  createdAt DateTime @default(now()) @map("created_at")

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, shopId])
  @@index([shopId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
